#include <winver.h>

// 内置模板：构建时由 编译\build_embed_tool.bat 从 Release\version.dll 复制而来。
// 运行期用 FindResourceW(hInst, MAKEINTRESOURCE(1), L"TEMPLATE") 取出。
1 TEMPLATE "template.dll"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Nepgear"
            VALUE "FileDescription", "Nepgear 补丁打包器"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "NepgearEmbed"
            VALUE "OriginalFilename", "NepgearEmbed.exe"
            VALUE "ProductName", "Nepgear"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
