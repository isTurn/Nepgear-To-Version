  <!-- The Release DLL is always shipped uncompressed: a plain PE image loads
       without an unpack stub and can be inspected with ordinary tools. -->
  <!-- Switching proxy host changes IntDir, so the objects the
       linker compares against are not the ones the previous build produced. Left alone, Link looks
       up-to-date (the old DLL is newer than these objects) and we ship the
       previous binary. Record the last setting and drop the output whenever it
       changes. -->
  <Target Name="NepgearSettingsGuard" BeforeTargets="Link">
    <PropertyGroup>
      <NepgearSettingsFile>$(ProjectDir)obj\last-build-settings.txt</NepgearSettingsFile>
      <NepgearSettingsToken>$(NepgearProxy)</NepgearSettingsToken>
      <NepgearPreviousSettings />
    </PropertyGroup>
    <ReadLinesFromFile File="$(NepgearSettingsFile)" Condition="Exists('$(NepgearSettingsFile)')">
      <Output TaskParameter="Lines" PropertyName="NepgearPreviousSettings" />
    </ReadLinesFromFile>
    <Delete Files="$(TargetPath)"
        Condition="'$(NepgearPreviousSettings)'!='$(NepgearSettingsToken)'" />
    <MakeDir Directories="$(ProjectDir)obj" />
    <WriteLinesToFile File="$(NepgearSettingsFile)" Lines="$(NepgearSettingsToken)" Overwrite="true" />
  </Target>
