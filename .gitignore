# Template DLL copied in by 编译/build_embed_tool.bat (removed after build)
/tools/NepgearEmbed/template_x86.dll
/tools/NepgearEmbed/template_x64.dll

# Python caches
__pycache__/
*.pyc

# Local workspace data (agent memory / session state)
.workbuddy/
