  <PropertyGroup Label="UserMacros" />
  <!-- Proxy host DLL. version is the default deployment target (the shipped
       build forwards the 17 exports of the system version.dll); winmm is kept
       as an opt-in for games that import winmm.dll instead.
       Override from the command line or from build.bat:
         msbuild Nepgear.sln -p:NepgearProxy=winmm
       TargetName, the proxy header in dllmain.cpp and the MASM trampolines all
       follow this property, so the two builds never mix artifacts. -->
  <PropertyGroup>
    <NepgearProxy Condition="'$(NepgearProxy)'==''">version</NepgearProxy>
    <NepgearProxyIsVersion Condition="'$(NepgearProxy)'=='version'">true</NepgearProxyIsVersion>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir Condition="'$(Platform)'=='Win32'">$(ProjectDir)..\$(Configuration)\</OutDir>
    <OutDir Condition="'$(Platform)'=='x64'">$(ProjectDir)..\x64\$(Configuration)\</OutDir>
    <!-- One IntDir per proxy host: dllmain.cpp compiles a different proxy
         header and a different set of exports. MSBuild only compares
         timestamps, so without a separate IntDir a toggle would silently
         reuse the previous objects. -->
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\$(NepgearProxy)\</IntDir>
  </PropertyGroup>
